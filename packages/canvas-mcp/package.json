{
  "name": "@canvas2026/canvas-mcp",
  "version": "0.1.0",
  "description": "MCP server for CANVAS 2026 — let your agent read and paint the canvas",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/AnmarAbdi/canvas-kit.git", "directory": "packages/canvas-mcp" },
  "homepage": "https://github.com/AnmarAbdi/canvas-kit#readme",
  "bugs": "https://github.com/AnmarAbdi/canvas-kit/issues",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./signer": { "types": "./dist/signer.d.ts", "default": "./dist/signer.js" }
  },
  "bin": { "canvas-mcp": "./dist/bin.js" },
  "files": ["dist"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "vitest run" },
  "dependencies": {
    "@canvas2026/client": "^0.1.0",
    "@canvas2026/converter": "^0.1.0",
    "@canvas2026/shared": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": { "typescript": "^5.7.3", "vitest": "2.1.9" }
}
